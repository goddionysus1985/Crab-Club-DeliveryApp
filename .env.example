# ===================================================================
# CRAB CLUB DELIVERY APP — PRODUCTION ENVIRONMENT CONFIGURATION
# ===================================================================

# -------------------------------------------------------------------
# 1. POSTER POS INTEGRATION (Каса та кухня)
# -------------------------------------------------------------------
# Отримайте в адмінці Poster: Налаштування -> Доступ до API -> Створити токен
VITE_POSTER_API_TOKEN=
# Номер точки продажу в Poster (зазвичай 1 для першої точки)
VITE_POSTER_SPOT_ID=1

# -------------------------------------------------------------------
# 2. ОНЛАЙН-ОПЛАТА КАРТАМИ (MONOBANK / WAYFORPAY)
# -------------------------------------------------------------------
# Включити прийом оплат картками на сайті (true / false)
VITE_ENABLE_ONLINE_PAYMENT=true

# Monobank Інтернет-еквайринг: Отримайте токен в кабінеті web.monobank.ua
VITE_MONOBANK_TOKEN=

# WayForPay / LiqPay (Альтернативний шлюз):
VITE_WAYFORPAY_MERCHANT_ACCOUNT=
VITE_WAYFORPAY_MERCHANT_SECRET_KEY=

# -------------------------------------------------------------------
# 3. TELEGRAM УВІДОМЛЕННЯ ДЛЯ КУХНІ ТА АДМІНІСТРАТОРА
# -------------------------------------------------------------------
# Токен бота для відправки чеків (за замовчуванням @crabclub_bot)
TELEGRAM_BOT_TOKEN=8876828349:AAGRzgX60aFsEYD5MRiE5rePRHeCkC7jXQ0
# Chat ID робочого чату ресторану, куди надсилати чеки нових замовлень
TELEGRAM_KITCHEN_CHAT_ID=

# -------------------------------------------------------------------
# 4. ЗАГАЛЬНІ НАЛАШТУВАННЯ
# -------------------------------------------------------------------
VITE_RESTAURANT_NAME="CRAB CLUB"
VITE_RESTAURANT_PHONE="+380981234567"
VITE_RESTAURANT_CITY="смт. Овідіополь"
