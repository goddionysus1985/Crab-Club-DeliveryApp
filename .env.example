# ==========================================
# CRAB CLUB — Poster POS Environment Config
# ==========================================

# 1. Отримайте Access Token у вашій адмін-панелі Poster:
#    Налаштування -> Доступ до API -> Створити токен
VITE_POSTER_API_TOKEN=

# 2. ID закладу (Spot ID) з Poster (за замовчуванням 1):
VITE_POSTER_SPOT_ID=1

# 3. Назва облікового запису Poster:
VITE_POSTER_ACCOUNT=crab-club
